# Copy this file to .env.local for local development with vercel dev.
# NEVER commit the real .env.local file — it's already in .gitignore.
#
# In production, set this in Vercel → Project Settings → Environment Variables
# (not in this file, and not anywhere in client-side code).

# API key for the AI provider used by /api/ask.ts (Anthropic API key).
# Used ONLY inside the serverless function — never sent to the browser.
ANTHROPIC_API_KEY=your-api-key-here